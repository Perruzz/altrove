<?xml version="1.0" encoding="utf-8"?>
<!--
    The night sky of the app and of its widget. Space looks the same in light and dark theme,
    so there are no -night or -v31 variants of these colours.
-->
<resources>
    <!-- Window and splash background, under the Compose sky. -->
    <color name="space_background">#070718</color>

    <!-- Widget at rest: deep indigo with a violet glow in one corner. -->
    <color name="widget_idle_top">#241D66</color>
    <color name="widget_idle_bottom">#0B0B28</color>
    <color name="widget_idle_glow">#705B3DF5</color>
    <color name="widget_idle_edge">#38C6BDFF</color>
    <color name="widget_idle_icon_top">#9D8FFF</color>
    <color name="widget_idle_icon_bottom">#4A3DD6</color>
    <color name="widget_idle_icon">#FFFFFF</color>
    <color name="widget_idle_title">#FFFFFF</color>
    <color name="widget_idle_subtitle">#C6BDFF</color>

    <!-- Widget during a session: the magenta of "elsewhere", as in the app. -->
    <color name="widget_active_top">#7C2379</color>
    <color name="widget_active_bottom">#2A1B6E</color>
    <color name="widget_active_glow">#80FF6FB5</color>
    <color name="widget_active_edge">#55FFB3D9</color>
    <color name="widget_active_icon_background">#FFF2F8</color>
    <color name="widget_active_icon">#C2318B</color>
    <color name="widget_active_title">#FFFFFF</color>
    <color name="widget_active_subtitle">#FFD0E8</color>

    <color name="widget_ripple">#33FFFFFF</color>
</resources>
